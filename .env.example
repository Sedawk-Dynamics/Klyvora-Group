# SMTP configuration for the contact form (/api/contact)
# Copy this file to .env.local and fill in real values.

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password

# The address the email is sent FROM (often must match SMTP_USER / a verified sender)
FROM_EMAIL=no-reply@klyvora-group.com

# Where contact-form submissions are delivered
TO_EMAIL=Info@klyvora-group.com

# Ghost Content API (blog) — read-only key, used server-side to fetch posts
GHOST_API_URL=https://blog.klyvora-group.com
GHOST_CONTENT_API_KEY=your-ghost-content-api-key
